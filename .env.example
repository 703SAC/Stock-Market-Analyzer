APP_ENV=local
DATABASE_URL=sqlite:///./data/analyzer.sqlite
# Encrypted secrets use SECRET_ENCRYPTION_KEY from the OS env or local .secret.key.
# Create .secret.key with: cd app/backend && python scripts/secure_config.py generate-key

KIS_CONFIG_PATH=~/KIS/config/kis_devlp.yaml
KIS_SVR=prod

NEWS_PROVIDER=naver
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

OPENDART_API_KEY=

# LLM_PROVIDER: openrouter(역할별 free 모델) | google(Google AI Studio) | anthropic(legacy 고급 슬롯) | openai
LLM_PROVIDER=google
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL 비우면 provider별 기본값(google=gemini-2.5-flash, anthropic=gemini-3.5-flash)
LLM_MODEL=
LLM_ADVANCED_MODEL=
LLM_DEFAULT_ROLE=flash
LLM_FLASH_MODEL=meta-llama/llama-3.2-3b-instruct:free
LLM_PRO_MODEL=meta-llama/llama-3.3-70b-instruct:free
LLM_FORMATTER_MODEL=qwen/qwen3-coder-480b-a35b:free
LLM_RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2:free

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 모니터링 에이전트 스케줄러(낮/밤 교대). 상시구동 환경에서만 true 권장.
SCHEDULER_ENABLED=false
MARKET_TZ=Asia/Seoul

CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
