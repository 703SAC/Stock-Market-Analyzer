APP_ENV=local
DATABASE_URL=sqlite:///./data/analyzer.sqlite

KIS_CONFIG_PATH=~/KIS/config/kis_devlp.yaml
KIS_SVR=prod

NEWS_PROVIDER=naver
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

OPENDART_API_KEY=

# LLM_PROVIDER: google(기본·무료) | openai | anthropic(고차원 스위칭, 유료·opt-in)
LLM_PROVIDER=google
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
# LLM_MODEL 비우면 provider별 기본값(google=gemini-2.0-flash, anthropic=claude-sonnet-4-6)
LLM_MODEL=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 모니터링 에이전트 스케줄러(낮/밤 교대). 상시구동 환경에서만 true 권장.
SCHEDULER_ENABLED=false
MARKET_TZ=Asia/Seoul

CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
